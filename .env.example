# Groq API key used server-side only (never exposed to the browser).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the vision-capable model used for extraction.
# Defaults to qwen/qwen3.6-27b if unset. Check https://console.groq.com/docs/models
# for current vision-capable models — Groq periodically deprecates/renames models.
# GROQ_MODEL=qwen/qwen3.6-27b
